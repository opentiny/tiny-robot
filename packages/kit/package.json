{
  "name": "@opentiny/tiny-robot-kit",
  "version": "0.4.1-alpha.2",
  "homepage": "https://docs.opentiny.design/tiny-robot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentiny/tiny-robot.git"
  },
  "bugs": {
    "url": "https://github.com/opentiny/tiny-robot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "AI大模型请求与数据处理工具包",
  "keywords": [
    "vue",
    "vue3",
    "ai",
    "ai-client",
    "ai-sdk",
    "chat",
    "chatbot",
    "llm",
    "openai",
    "assistant",
    "streaming",
    "composables",
    "conversation",
    "model-provider",
    "tiny-robot",
    "opentiny"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/core.ts --format cjs,esm --dts --minify",
    "dev": "tsup src/index.ts src/core.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.17",
    "openai": "^6.34.0",
    "tsup": "^8.0.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
