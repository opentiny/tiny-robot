{
  "name": "tiny-robot-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "pnpm run test:e2e && pnpm run test:ct",
    "test:e2e": "playwright test",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "test:ui": "playwright test --ui",
    "test:codegen": "playwright codegen localhost:3333",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@opentiny/tiny-robot": "workspace:*",
    "@opentiny/tiny-robot-svgs": "workspace:*",
    "@opentiny/vue": "^3.20.0",
    "vue": "^3.3.11"
  },
  "devDependencies": {
    "@playwright/experimental-ct-vue": "1.62.0",
    "@playwright/test": "1.62.0",
    "@types/node": "^22.13.17",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/compiler-dom": "3.5.29",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vue-tsc": "^2.2.8"
  }
}
