{
  "name": "@opentiny/tiny-robot-chat",
  "version": "1.0.0-alpha.0",
  "license": "MIT",
  "description": "TinyRobot Chat application assembly package",
  "homepage": "https://docs.opentiny.design/tiny-robot/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opentiny/tiny-robot.git"
  },
  "bugs": {
    "url": "https://github.com/opentiny/tiny-robot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "browser": "./dist/experimental.js",
      "node": "./dist/experimental-node.js",
      "import": "./dist/experimental.js"
    },
    "./experimental/web-component.css": "./dist/web-component.css",
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README*"
  ],
  "scripts": {
    "build": "pnpm type-check && pnpm build:stable && pnpm build:experimental",
    "build:stable": "vite build",
    "build:experimental": "vite build --config vite.experimental.config.ts",
    "dev": "vite --host 0.0.0.0",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentiny/tiny-robot": "workspace:*",
    "@opentiny/tiny-robot-kit": "workspace:*",
    "@opentiny/tiny-robot-svgs": "workspace:*",
    "@vueuse/core": "^13.9.0"
  },
  "peerDependencies": {
    "vue": "^3.3.11"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "typescript": "^5.2.2",
    "vitest": "^1.6.1",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.3.11",
    "vue-tsc": "^2.2.8"
  }
}
