    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentiny/tiny-robot": "workspace:*",
    "@opentiny/tiny-robot-kit": "workspace:*",
    "@opentiny/tiny-robot-svgs": "workspace:*",
    "@vueuse/core": "13.9.0"
  },
  "peerDependencies": {
    "vue": "^3.3.11"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "typescript": "^5.2.2",
    "vitest": "^1.6.1",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.3.11",
    "vue-tsc": "^2.2.8"
  }
