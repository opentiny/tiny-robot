{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/.temp/vanilla-types/index.d.ts",
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.vanilla.json"
  },
  "apiReport": {
    "enabled": false,
    "reportFileName": "vanilla.api.md"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": true,
    "untrimmedFilePath": "<projectFolder>/dist/vanilla/index.d.ts"
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      }
    }
  }
}
