{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentiny.design/schemas/article-frontmatter.schema.json",
  "title": "OpenTiny article Front Matter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "title",
    "summary",
    "project",
    "article_type",
    "style_profile",
    "sources",
    "approved_plan",
    "article_date"
  ],
  "properties": {
    "schema_version": {
      "const": "article-hub.article"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "enum": ["webmcp-sdk", "genui-sdk", "tiny-robot"]
    },
    "article_type": {
      "enum": ["release", "practical-guide", "source-analysis", "case-study"]
    },
    "style_profile": {
      "enum": [
        "official-balanced",
        "developer-friendly",
        "release-promotional",
        "technical-deep-dive"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "approved_plan": {
      "type": "object",
      "required": ["version", "hash"],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": ["integer", "string"]
        },
        "hash": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "article_date": {
      "type": "string",
      "minLength": 1
    }
  }
}
