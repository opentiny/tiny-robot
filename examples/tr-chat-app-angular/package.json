{
  "name": "tr-chat-app-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node scripts/env.mjs && ng serve --host 127.0.0.1 --port 4348",
    "type-check": "node scripts/env.mjs && ngc -p tsconfig.app.json --noEmit",
    "build": "node scripts/env.mjs && ng build",
    "test:env": "node --test scripts/env.test.mjs",
    "build:test": "node scripts/env.mjs --test && ng build --configuration=test"
  },
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/forms": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "@opentiny/tiny-robot": "1.0.1-alpha.1",
    "@opentiny/tiny-robot-chat": "1.0.1-alpha.1",
    "@opentiny/tiny-robot-kit": "1.0.1-alpha.1",
    "@opentiny/tiny-robot-svgs": "1.0.1-alpha.1",
    "dompurify": "3.4.18",
    "markdown-it": "14.3.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.42",
    "@angular/cli": "20.3.42",
    "@angular/compiler-cli": "20.3.35",
    "@types/markdown-it": "14.2.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.34.5"
}
