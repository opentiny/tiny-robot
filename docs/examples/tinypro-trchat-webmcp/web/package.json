{
  "name": "tinypro-trchat-webmcp-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "TinyPro and TrChat WebMCP integration best practice",
  "author": "Tiny Team",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start:mock": "cross-env VITE_USE_MOCK=true run-p mock dev",
    "dev": "vite --config ./config/vite.config.dev.ts --port 3031",
    "dev:full": "cross-env VITE_USE_MOCK=false pnpm dev",
    "build": "vite build --config ./config/vite.config.prod.ts",
    "preview": "vite preview",
    "report": "cross-env REPORT=true npm run build",
    "lint-staged": "npx lint-staged",
    "mock": "tsx ./src/mock/index.ts",
    "test:webmcp": "node --import tsx --test tests/webmcp-tools.test.ts",
    "test:mock": "node --import tsx --test src/mock/*.test.ts src/utils/*.test.ts config/*.test.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@babel/core": "^7.25.2",
    "@mcp-b/webmcp-polyfill": "^3.0.0",
    "@mcp-b/webmcp-types": "^3.0.0",
    "@opentiny/fluent-editor": "^4.1.2",
    "@opentiny/icons": "^0.1.3",
    "@opentiny/next-sdk": "^0.4.1",
    "@opentiny/tiny-robot": "https://pkg.pr.new/opentiny/tiny-robot/@opentiny/tiny-robot@2f1aa59",
    "@opentiny/tiny-robot-chat": "https://pkg.pr.new/opentiny/tiny-robot/@opentiny/tiny-robot-chat@2f1aa59",
    "@opentiny/tiny-robot-kit": "https://pkg.pr.new/opentiny/tiny-robot/@opentiny/tiny-robot-kit@2f1aa59",
    "@opentiny/tiny-robot-svgs": "https://pkg.pr.new/opentiny/tiny-robot/@opentiny/tiny-robot-svgs@2f1aa59",
    "@opentiny/vue": "^3.32.0",
    "@opentiny/vue-huicharts": "~3.32.0",
    "@opentiny/vue-icon": "~3.32.0",
    "@opentiny/vue-locale": "~3.32.0",
    "@opentiny/vue-search-box": "^0.1.6",
    "@opentiny/vue-theme": "~3.32.0",
    "@vueuse/core": "13.9.0",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.20.0",
    "fp-ts": "^2.16.1",
    "mitt": "^3.0.1",
    "nprogress": "^1.0.0-1",
    "pinia": "4.1.0",
    "query-string": "^8.2.0",
    "quill-cursors": "^4.3.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.0.0",
    "vue-router": "5.5.0",
    "xlsx": "^0.18.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-quill": "^1.0.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^12.1.4",
    "@types/lodash": "^4.17.9",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^22.14.1",
    "@types/nprogress": "^0.2.3",
    "@types/resize-observer-browser": "^0.1.11",
    "@unocss/eslint-plugin": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/babel-helper-vue-jsx-merge-props": "^1.4.0",
    "@vue/babel-plugin-jsx": "^1.2.5",
    "@vue/babel-preset-jsx": "^1.4.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.18.0",
    "eslint-plugin-format": "^1.3.1",
    "husky": "^7.0.4",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "lint-staged": "^11.2.6",
    "mockjs": "^1.1.0",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "style-loader": "^4.0.0",
    "style-resources-loader": "1.5.0",
    "stylelint": "^13.13.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^20.0.0",
    "stylelint-order": "^4.1.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "unocss": "^66.13.0",
    "vite": "^8.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-svg-loader": "^4.0.0",
    "vue-style-loader": "^4.1.3",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue}": [
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "eslint --fix"
    ]
  }
}
